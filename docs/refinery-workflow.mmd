        E_REGENERATE --> E_VALIDATE
        E_VALIDATE --> E_REVIEW
        E_REVIEW --> E_COMMIT
        E_COMMIT --> E_NEXT
        E_NEXT -->|No| E_INGESTION
        E_NEXT -->|Yes| E_QUEUE
    end

    subgraph migration_track["Migration Track"]
