        E_REVIEW["10. Human review<br/>Confirm correctness and no drift<br/>Update candidate record if one is used"]
        E_COMMIT["11. Git commit<br/>Commit the accepted framework change"]
        E_NEXT{"12. Existing speech artifacts need updating?"}
        E_INGESTION["Return to Ingestion Track"]
        E_QUEUE["Queue for a future Migration Track batch"]

        E_TRIGGER --> E_RECORD
